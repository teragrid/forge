#!/usr/bin/env bash
# .githooks/pre-push
#
# Forge pre-push quality gate.
# Runs on every `git push`; blocks the push and prints a clear summary on any failure.
#
# Install (one-time):
#   git config core.hooksPath .githooks
#   — or —
#   make hooks
#
# Skip (emergency only – do NOT make a habit of this):
#   SKIP_PRE_PUSH=1 git push
#
# Per-stage skips (emergency only – recorded to .forge/audit.log):
#   FORGE_SKIP_SCAN=1   git push   # skip forge scan security
#   FORGE_SKIP_LINT=1   git push   # skip forge lint
#   FORGE_SKIP_CHECK=1  git push   # skip forge check
#   FORGE_SKIP_QA=1     git push   # skip forge qa real-command suite (stage 12)
#   FORGE_SKIP_SHIP=1   git push   # skip forge ship dry-run scenarios (stage 13)
#
# Checks (in order – fail-fast per section):
#   1.  gofmt / goimports — formatting
#   2.  go vet            — correctness
#   3.  golangci-lint     — static analysis (gocritic, staticcheck, gosec, errcheck, …)
#   4.  go build          — compilation
#   5.  go test           — unit tests (no -race here because CGO may be off on the
#                           developer machine; CI runs -race on Linux where CGO is on)
#   6.  govulncheck       — known CVEs in deps
#   7.  go mod verify     — tamper-check downloaded module zips
#   8.  (reserved)
#   9.  forge scan security --secrets  — secret / credential leak detection
#   10. forge lint                     — Forge convention violations
#   11. forge check                    — pre-flight: typecheck + lint + test fast path
#   12. forge qa suite                 — real-command integration (init, scan, skill,
#                                       mcp, audit, test spec, spend, context, doctor)
#   13. forge ship dry-run scenarios  — ship pipeline smoke tests (QA-22 – QA-33)
#
# Stages 9-11 are ADVISORY when the forge binary is not on PATH (warn + skip).
# They become BLOCKING once `forge` is present.
#
# Each check prints a "✓ <name>" on success or "✗ <name>" + details on failure.

set -euo pipefail

# ── emergency bypass ────────────────────────────────────────────────────────
if [[ "${SKIP_PRE_PUSH:-}" == "1" ]]; then
  echo "⚠ SKIP_PRE_PUSH=1: all pre-push checks skipped — use only in emergencies"
  _AUDIT_DIR=".forge"
  if [[ -d "$_AUDIT_DIR" ]]; then
    echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"hook\":\"pre-push\",\"bypass\":\"SKIP_PRE_PUSH\",\"reason\":\"${SKIP_REASON:-<no reason given>}\"}" >> "$_AUDIT_DIR/audit.log"
  fi
  exit 0
fi

# ── helpers ─────────────────────────────────────────────────────────────────
GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; RESET='\033[0m'
FAILED=()

pass() { echo -e "${GREEN}✓${RESET} $1"; }
fail() { echo -e "${RED}✗${RESET} $1"; FAILED+=("$1"); }
warn() { echo -e "${YELLOW}⚠${RESET} $1"; }

need() {
  if ! command -v "$1" &>/dev/null; then
    warn "$1 not found — skipping (run 'make tools' to install)"
    return 1
  fi
  return 0
}

# Record a bypass to the audit log (best-effort, non-blocking).
audit_bypass() {
  local stage="$1" reason="${SKIP_REASON:-<no reason given>}"
  local audit_dir=".forge"
  if [[ -d "$audit_dir" ]]; then
    echo "{\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"hook\":\"pre-push\",\"bypass\":\"$stage\",\"reason\":\"$reason\"}" >> "$audit_dir/audit.log"
  fi
}

echo ""
echo "━━━  forge pre-push quality gate  (13 checks)  ━━━"
echo ""

# ── 1. formatting ────────────────────────────────────────────────────────────
echo "[1/12] formatting (gofmt + goimports)"
FMT_OUT=$(gofmt -s -l . 2>/dev/null || true)
if [[ -n "$FMT_OUT" ]]; then
  fail "gofmt -s"
  echo "      Files needing formatting:"
  echo "$FMT_OUT" | sed 's/^/        /'
  echo "      Fix with: gofmt -s -w ."
else
  pass "gofmt -s"
fi

if need goimports; then
  IMP_OUT=$(goimports -l . 2>/dev/null || true)
  if [[ -n "$IMP_OUT" ]]; then
    fail "goimports"
    echo "      Files with import issues:"
    echo "$IMP_OUT" | sed 's/^/        /'
    echo "      Fix with: goimports -w ."
  else
    pass "goimports"
  fi
fi

# ── 2. go vet ────────────────────────────────────────────────────────────────
echo ""
echo "[2/12] go vet"
if VET_OUT=$(go vet ./... 2>&1); then
  pass "go vet"
else
  fail "go vet"
  echo "$VET_OUT" | sed 's/^/      /'
fi

# ── 3. golangci-lint ─────────────────────────────────────────────────────────
echo ""
echo "[3/12] golangci-lint"
if need golangci-lint; then
  if LINT_OUT=$(golangci-lint run ./... 2>&1); then
    pass "golangci-lint"
  else
    fail "golangci-lint"
    echo "$LINT_OUT" | sed 's/^/      /'
  fi
fi

# ── 4. build ─────────────────────────────────────────────────────────────────
echo ""
echo "[4/12] go build"
if BUILD_OUT=$(CGO_ENABLED=0 go build ./... 2>&1); then
  pass "go build"
else
  fail "go build"
  echo "$BUILD_OUT" | sed 's/^/      /'
fi

# ── 5. tests ─────────────────────────────────────────────────────────────────
echo ""
echo "[5/12] go test"
# -count=1 disables the test cache so we always exercise the full suite.
# Capture output + exit code separately; don't let set -e abort on test exit.
TEST_OUT=$(go test -count=1 ./... 2>&1 || true)
if echo "$TEST_OUT" | grep -qE "^(FAIL|--- FAIL)"; then
  # Real test failures — at least one test file reported FAIL.
  fail "go test"
  # Show only the FAIL lines to keep output readable.
  echo "$TEST_OUT" | grep -E "^(FAIL|---)" | sed 's/^/      /' || echo "$TEST_OUT" | tail -30 | sed 's/^/      /'
elif echo "$TEST_OUT" | grep -qiE "(unlinkat|Access is denied|remove.*\.exe)"; then
  # Windows-only: Go runtime cannot delete the test binary from the temp dir
  # after the process exits (file still locked by AV or shell).  All test
  # packages reported "ok" — treat as a pass with a note.
  pass "go test (Windows temp-file cleanup warning — all packages ok)"
else
  pass "go test"
fi

# ── 6. govulncheck ───────────────────────────────────────────────────────────
echo ""
echo "[6/12] govulncheck (known CVEs)"
if need govulncheck; then
  if VULN_OUT=$(govulncheck ./... 2>&1); then
    pass "govulncheck"
  else
    fail "govulncheck"
    echo "$VULN_OUT" | sed 's/^/      /'
  fi
fi

# ── 7. module integrity ───────────────────────────────────────────────────────
echo ""
echo "[7/12] go mod verify"
if VERIFY_OUT=$(go mod verify 2>&1); then
  pass "go mod verify"
else
  fail "go mod verify"
  echo "$VERIFY_OUT" | sed 's/^/      /'
fi

# ── 8. (reserved for future gate) ───────────────────────────────────────────

# ── 9. forge scan security ───────────────────────────────────────────────────
echo ""
echo "[9/12] forge scan security"
if [[ "${FORGE_SKIP_SCAN:-}" == "1" ]]; then
  warn "FORGE_SKIP_SCAN=1: forge scan security skipped"
  audit_bypass "FORGE_SKIP_SCAN"
elif ! command -v forge &>/dev/null; then
  warn "forge binary not on PATH — skipping scan (run 'make build' to install)"
else
  if SCAN_OUT=$(forge scan security --json --min-confidence medium 2>&1); then
    pass "forge scan security"
  else
    fail "forge scan security"
    echo "$SCAN_OUT" | sed 's/^/      /'
    echo "      Secrets found — resolve before pushing (FORGE-6200)"
    echo "      Emergency bypass: FORGE_SKIP_SCAN=1 SKIP_REASON='...' git push"
  fi
fi

# ── 10. forge lint ───────────────────────────────────────────────────────────
echo ""
echo "[10/12] forge lint"
if [[ "${FORGE_SKIP_LINT:-}" == "1" ]]; then
  warn "FORGE_SKIP_LINT=1: forge lint skipped"
  audit_bypass "FORGE_SKIP_LINT"
elif ! command -v forge &>/dev/null; then
  warn "forge binary not on PATH — skipping lint (run 'make build' to install)"
else
  if FLINT_OUT=$(forge lint 2>&1); then
    pass "forge lint"
  else
    fail "forge lint"
    echo "$FLINT_OUT" | sed 's/^/      /'
    echo "      Convention violations found — resolve before pushing (FORGE-3100)"
    echo "      Emergency bypass: FORGE_SKIP_LINT=1 SKIP_REASON='...' git push"
  fi
fi

# ── 11. forge check ──────────────────────────────────────────────────────────
echo ""
echo "[11/12] forge check"
if [[ "${FORGE_SKIP_CHECK:-}" == "1" ]]; then
  warn "FORGE_SKIP_CHECK=1: forge check skipped"
  audit_bypass "FORGE_SKIP_CHECK"
elif ! command -v forge &>/dev/null; then
  warn "forge binary not on PATH — skipping check (run 'make build' to install)"
else
  if FCHECK_OUT=$(forge check 2>&1); then
    pass "forge check"
  else
    fail "forge check"
    echo "$FCHECK_OUT" | sed 's/^/      /'
    echo "      Pre-flight check failed — resolve before pushing"
    echo "      Emergency bypass: FORGE_SKIP_CHECK=1 SKIP_REASON='...' git push"
  fi
fi

# ── 12. forge qa real-command suite ─────────────────────────────────────────
echo ""
echo "[12/12] forge qa real-command suite"
if [[ "${FORGE_SKIP_QA:-}" == "1" ]]; then
  warn "FORGE_SKIP_QA=1: forge qa suite skipped"
  audit_bypass "FORGE_SKIP_QA"
elif ! command -v forge &>/dev/null; then
  warn "forge binary not on PATH — skipping qa suite (run 'make build' to install)"
else
  QA_SCRIPT="$(cd "$(dirname "$0")" && pwd)/../scripts/forge-qa-real.sh"
  if [[ ! -f "$QA_SCRIPT" ]]; then
    # Fallback: look relative to the repo root via git rev-parse
    QA_SCRIPT="$(git rev-parse --show-toplevel 2>/dev/null)/scripts/forge-qa-real.sh"
  fi
  if [[ ! -f "$QA_SCRIPT" ]]; then
    warn "scripts/forge-qa-real.sh not found — skipping qa suite"
  elif QA_OUT=$(bash "$QA_SCRIPT" 2>&1); then
    echo "$QA_OUT" | sed 's/^/      /'
    pass "forge qa real-command suite"
  else
    echo "$QA_OUT" | sed 's/^/      /'
    fail "forge qa real-command suite"
    echo "      Emergency bypass: FORGE_SKIP_QA=1 SKIP_REASON='...' git push"
  fi
fi

# ── 13. forge ship dry-run scenarios ─────────────────────────────────────────
echo ""
echo "[13/13] forge ship dry-run scenarios"
if [[ "${FORGE_SKIP_SHIP:-}" == "1" ]]; then
  warn "FORGE_SKIP_SHIP=1: forge ship scenarios skipped"
  audit_bypass "FORGE_SKIP_SHIP"
elif ! command -v forge &>/dev/null; then
  warn "forge binary not on PATH — skipping ship scenarios (run 'make build' to install)"
else
  SHIP_QA_SCRIPT="$(cd "$(dirname "$0")" && pwd)/../scripts/forge-qa-real.sh"
  if [[ ! -f "$SHIP_QA_SCRIPT" ]]; then
    SHIP_QA_SCRIPT="$(git rev-parse --show-toplevel 2>/dev/null)/scripts/forge-qa-real.sh"
  fi
  if [[ ! -f "$SHIP_QA_SCRIPT" ]]; then
    warn "scripts/forge-qa-real.sh not found — skipping ship scenarios"
  elif SHIP_QA_OUT=$(SHIP_QA_ONLY=1 FORGE_NO_LLM=1 bash "$SHIP_QA_SCRIPT" 2>&1); then
    echo "$SHIP_QA_OUT" | grep -E 'QA-2[2-9]|QA-3[0-3]' | sed 's/^/      /' || true
    pass "forge ship dry-run scenarios"
  else
    echo "$SHIP_QA_OUT" | sed 's/^/      /'
    fail "forge ship dry-run scenarios"
    echo "      Emergency bypass: FORGE_SKIP_SHIP=1 SKIP_REASON='...' git push"
  fi
fi

# ── summary ──────────────────────────────────────────────────────────────────
echo ""
if [[ ${#FAILED[@]} -eq 0 ]]; then
  echo -e "${GREEN}━━━  all checks passed — push allowed  ━━━${RESET}"
  echo ""
  exit 0
else
  echo -e "${RED}━━━  ${#FAILED[@]} check(s) failed — push blocked  ━━━${RESET}"
  for f in "${FAILED[@]}"; do
    echo -e "  ${RED}✗${RESET} $f"
  done
  echo ""
  echo "  Fix the issues above, then re-run: git push"
  echo "  Emergency bypass (DO NOT abuse): SKIP_PRE_PUSH=1 git push"
  echo ""
  exit 1
fi
