# Build artefacts
/dist/
/bin/
*.exe
*.test
*.out
coverage.out
coverage.html

# Go workspace files
go.work
go.work.sum

# Editor / OS
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# Forge runtime scratch (per spec §4 hygiene)
.forge/cache/
.forge/scratch/
.forge/scan-history/
.forge/trash/
.forge/snapshots/
.forge/learned/
# Runtime .forge dirs that tools write inside source packages (any depth)
**/.forge/scan-history/
**/.forge/context/
**/.forge/specs/
**/.forge/trash/
**/.forge/snapshots/
# Un-ignore the top-level project specs dir so spec.md files are tracked
!.forge/specs/
**/.forge/audit.log

# ── Private / development-phase files (kept local, never pushed) ──────────────
/private/
# ADRs live in private/docs/adr/ — if one accidentally lands here, block it.
docs/rfcs/ADR-*.md
# Knowledge base — proprietary IP, not in public repo.
/forge-knowledge/
# Generated encrypted knowledge index (private build artifact).
internal/knowledge/zdata_private.go
# Plain-text JSON index (intermediate artifact, contains unencrypted KB content).
internal/knowledge/data/
# ─────────────────────────────────────────────────────────────────────────────

# Playwright MCP browser session files (development-only cache)
.playwright-mcp/

# forge:gitignore:start
# Managed by forge — do not edit manually. Run "forge upgrade gitignore-marker" to refresh.
.forge/scratch/
.forge/cache/
*.tmp
*.bak
__pycache__/
# forge:gitignore:end
