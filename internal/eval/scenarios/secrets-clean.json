{
  "name": "secrets-clean",
  "description": "Verify that forge scan detects and redacts secrets.",
  "workdir": "tmpdir",
  "steps": [
    {
      "id": "scan-secrets",
      "run": ["forge", "scan", "secrets", "--json"],
      "expect": {
        "exit": 0,
        "stdout_contains": ["findings"]
      }
    }
  ]
}
