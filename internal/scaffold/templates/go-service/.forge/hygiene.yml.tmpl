# Forge Hygiene Manifest — {{.Name}}
# Generated by forge new go-service (forge {{.ForgeVer}})
#
# Controls `forge clean --check` and `forge clean --apply`.
# Add patterns for legitimate generated artefacts in [managed].
# Scratch patterns in [scratch] trigger warnings from `forge clean --check`.
#
# Run `forge clean --check` before every commit.
# Run `forge clean --apply` to delete confirmed scratch files.

[scratch]
# LLM scratch areas
**/.forge/llm-scratch/**
**/.forge/scratch/**
**/.forge/cache/**
# Temporary files from LLM-assisted workflows
**/_*
**/patch_*
**/fix_*
**/*_output.*
**/*_SUMMARY*.md
**/scratch/**
# Common editor temporaries
**/*.tmp
**/*.tmp.*
**/*.swp
**/*.swo
**/*~
# Build artefacts that should not be committed
**/tmp/**
**/dist/**
**/build/**

[managed]
# Framework-managed files (do not delete)
.gitignore
.gitleaks.toml
.forge/manifest
.forge/hygiene.yml
.forge/conventions.json
.forge-conventions
.forge/instructions/**
# AI-tool instruction files (Developer Promise #4)
AGENTS.md
CLAUDE.md
.cursorrules
.windsurfrules
# Project root
README.md
LICENSE
forge.config.yml
ROLLBACK.md
# Go module files
go.mod
go.sum
# CI/CD
.github/workflows/**
# Application source (never scratch)
cmd/**
internal/**
migrations/**
tests/**
