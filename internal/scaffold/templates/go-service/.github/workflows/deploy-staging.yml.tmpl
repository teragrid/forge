name: Deploy — Staging — {{.Name}}
# Generated by forge new go-service (forge {{.ForgeVer}})

on:
  push:
    branches: [develop]
  workflow_dispatch:

env:
  GO_VERSION: "1.24"

jobs:
  deploy-staging:
    name: Deploy to Staging
    runs-on: ubuntu-latest
    environment:
      name: staging
      url: ${{ "{{" }} steps.deploy.outputs.url {{ "}}" }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Build
        run: go build -o bin/{{.Name}} ./cmd/...
      - name: Run migrations (staging)
        env:
          DATABASE_URL: ${{ "{{" }} secrets.STAGING_DATABASE_URL {{ "}}" }}
        run: |
          go install github.com/teragrid/forge/cmd/forge@latest
          forge migrate up --env staging
      - name: Deploy
        id: deploy
        env:
          DEPLOY_TOKEN: ${{ "{{" }} secrets.STAGING_DEPLOY_TOKEN {{ "}}" }}
          STAGING_URL: ${{ "{{" }} vars.STAGING_APP_URL {{ "}}" }}
        run: |
          # Replace this step with your deployment command:
          # e.g. fly deploy, railway up, gcloud run deploy, etc.
          echo "Deploy step — configure for your platform"
          echo "url=${STAGING_URL}" >> "$GITHUB_OUTPUT"
      - name: Smoke test
        run: |
          go install github.com/teragrid/forge/cmd/forge@latest
          forge doctor --env staging --url "${{ "{{" }} steps.deploy.outputs.url {{ "}}" }}"
