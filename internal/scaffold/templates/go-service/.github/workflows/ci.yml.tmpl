name: CI

# Generated by forge new go-service (forge {{.ForgeVer}})
# Managed by forge upgrade ci — manual edits will be preserved in the
# "custom" section below.

on:
  push:
    branches: ["main", "release/*"]
  pull_request:
    branches: ["main"]

env:
  GO_VERSION: "1.24"

jobs:
  # ── Forge hygiene gate ────────────────────────────────────────────────────
  hygiene:
    name: "forge clean --check"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Install forge
        run: go install github.com/teragrid/forge/cmd/forge@latest
      - name: Hygiene check
        run: forge clean --check

  # ── Secret scan ───────────────────────────────────────────────────────────
  secrets:
    name: "forge scan security"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Install forge
        run: go install github.com/teragrid/forge/cmd/forge@latest
      - name: Security scan
        run: forge scan security

  # ── Convention lint ───────────────────────────────────────────────────────
  lint:
    name: "forge lint"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Install forge
        run: go install github.com/teragrid/forge/cmd/forge@latest
      - name: Convention lint
        run: forge lint

  # ── Unit + fast tests ─────────────────────────────────────────────────────
  test-unit:
    name: "go test (unit)"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Unit tests
        run: go test ./... -count=1 -race -timeout=120s

  # ── Integration tests (with Postgres) ────────────────────────────────────
  test-integration:
    name: "forge test integration"
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: forge
          POSTGRES_PASSWORD: forge
          POSTGRES_DB: {{.Name}}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Install forge
        run: go install github.com/teragrid/forge/cmd/forge@latest
      - name: Run migrations
        run: forge migrate up
        env:
          DATABASE_URL: postgres://forge:forge@localhost:5432/{{.Name}}_test
      - name: Integration tests
        run: go test ./tests/integration/... -count=1 -timeout=300s
        env:
          DATABASE_URL: postgres://forge:forge@localhost:5432/{{.Name}}_test

  # ── Security / RLS boundary tests ────────────────────────────────────────
  test-security:
    name: "forge test security"
    runs-on: ubuntu-latest
    needs: test-integration
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: forge
          POSTGRES_PASSWORD: forge
          POSTGRES_DB: {{.Name}}_security_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Install forge
        run: go install github.com/teragrid/forge/cmd/forge@latest
      - name: Run migrations
        run: forge migrate up
        env:
          DATABASE_URL: postgres://forge:forge@localhost:5432/{{.Name}}_security_test
      - name: Security / RLS tests
        run: go test ./tests/security/... -count=1 -timeout=300s
        env:
          DATABASE_URL: postgres://forge:forge@localhost:5432/{{.Name}}_security_test
