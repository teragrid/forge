name: Deploy — Production — {{.Name}}
# Generated by forge new go-service (forge {{.ForgeVer}})

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      skip_gate:
        description: 'Skip staging verification gate (requires reason)'
        required: false
        default: 'false'
      reason:
        description: 'Reason for skipping gate (required if skip_gate=true)'
        required: false

env:
  GO_VERSION: "1.24"

jobs:
  verify-staging:
    name: Verify Staging Health
    runs-on: ubuntu-latest
    if: ${{ "{{" }} github.event.inputs.skip_gate != 'true' {{ "}}" }}
    steps:
      - uses: actions/checkout@v4
      - name: Staging health gate
        env:
          STAGING_URL: ${{ "{{" }} vars.STAGING_APP_URL {{ "}}" }}
        run: |
          go install github.com/teragrid/forge/cmd/forge@latest
          forge doctor --env staging --url "$STAGING_URL"

  deploy-production:
    name: Deploy to Production
    runs-on: ubuntu-latest
    needs: [verify-staging]
    if: always() && (needs.verify-staging.result == 'success' || needs.verify-staging.result == 'skipped')
    environment:
      name: production
      url: ${{ "{{" }} steps.deploy.outputs.url {{ "}}" }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ "{{" }} env.GO_VERSION {{ "}}" }}
          cache: true
      - name: Build
        run: go build -o bin/{{.Name}} ./cmd/...
      - name: Run migrations (production)
        env:
          DATABASE_URL: ${{ "{{" }} secrets.PRODUCTION_DATABASE_URL {{ "}}" }}
        run: |
          go install github.com/teragrid/forge/cmd/forge@latest
          forge migrate up --env production
      - name: Deploy
        id: deploy
        env:
          DEPLOY_TOKEN: ${{ "{{" }} secrets.PRODUCTION_DEPLOY_TOKEN {{ "}}" }}
          PRODUCTION_URL: ${{ "{{" }} vars.PRODUCTION_APP_URL {{ "}}" }}
        run: |
          # Replace this step with your deployment command.
          echo "Deploy step — configure for your platform"
          echo "url=${PRODUCTION_URL}" >> "$GITHUB_OUTPUT"
