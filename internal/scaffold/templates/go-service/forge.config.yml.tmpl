# forge.config.yml — {{.Name}}
# Generated by forge new go-service (forge {{.ForgeVer}})
#
# Typed project configuration consumed by the Forge CLI.
# Run `forge doctor` to validate this file against the current schema.
# Full schema: https://forgeframework.dev/docs/config

version: "1"
project: "{{.Name}}"
module: "{{.Module}}"
description: "{{.Description}}"

# ── Tenancy ────────────────────────────────────────────────────────────────
tenancy:
  # model: workspace | account | none
  model: workspace
  # isolationLevel: row (RLS) | schema | database
  isolationLevel: row
  # Column name used for tenant isolation in all DB tables
  tenantColumn: workspace_id

# ── Authentication ─────────────────────────────────────────────────────────
auth:
  # provider: supabase | auth0 | custom
  provider: custom
  # sessionStrategy: jwt | session
  sessionStrategy: jwt
  # jwtExpiry: short-lived access tokens
  jwtExpiry: 15m
  # refreshExpiry: long-lived refresh tokens (secure HTTP-only cookies)
  refreshExpiry: 7d

# ── Security ──────────────────────────────────────────────────────────────
security:
  # owasp: strict | standard | off
  owasp: strict
  # rateLimit: enable rate limiting on public endpoints
  rateLimit: true
  # auditLog: write all mutating operations to the audit ledger
  auditLog: true
  # secretScan: run gitleaks on pre-commit and CI
  secretScan: true
  # webhookSignatureRequired: reject unsigned webhook payloads
  webhookSignatureRequired: true

# ── Testing ────────────────────────────────────────────────────────────────
testing:
  coverage:
    statements: 80
    branches: 70
  # rlsTests: require tests/security/ for every new RLS policy
  rlsTests: true
  # schemaAlignment: fail if DB schema drifts from migration history
  schemaAlignment: true
  # parallelTests: enforce t.Parallel() via forge lint
  parallelTests: true

# ── LLM Integration ────────────────────────────────────────────────────────
llm:
  # instructionsFormat: github-copilot | cursor | windsurf | all
  instructionsFormat: all
  # contextBundles: enable .forge/context/<task>.md auto-loading
  contextBundles: true
  # conventionLinter: error | warning | off
  conventionLinter: error
  # tokenBudget: max tokens per forge ship run (0 = unlimited)
  tokenBudget: 0
  # scratchRetention: how long to keep .forge/llm-scratch/ files
  scratchRetention: 7d

# ── Deployment ────────────────────────────────────────────────────────────
deployment:
  # pattern: rolling | blue-green | canary
  pattern: rolling
  # healthProbes: paths that must return 200 after deploy
  healthProbes:
    - /healthz
    - /readyz
  # autoRollback: roll back if health probes fail within this duration
  autoRollback: 5m

# ── Observability ─────────────────────────────────────────────────────────
observability:
  # logging: slog | zap | zerolog
  logging: slog
  # logFormat: json | text
  logFormat: json
  # metricsPort: Prometheus metrics endpoint (0 = disabled)
  metricsPort: 9090

# ── Telemetry (opt-in) ────────────────────────────────────────────────────
telemetry:
  # enabled: share anonymous usage stats with the Forge project
  enabled: false
  # endpoint: where to send telemetry (only used when enabled: true)
  endpoint: https://telemetry.forgeframework.dev/ingest
