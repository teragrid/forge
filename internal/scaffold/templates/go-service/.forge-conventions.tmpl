# .forge-conventions — {{.Name}}
# Generated by forge new go-service (forge {{.ForgeVer}})
#
# Convention enforcement configuration for `forge lint`.
# This file specifies which convention checks are enabled, their severity,
# and any path-based exceptions.
#
# Full convention definitions live in .forge/conventions.json.
# Run `forge lint` to check all conventions.
# Run `forge lint --fix` to auto-fix where possible (M2+).

[lint]
# Fail the lint run on any "error" severity violation (suitable for CI).
fail-on = "error"

# Emit warnings but do not fail on "warning" severity violations.
warn-on = "warning"

[paths]
# Paths excluded from convention checks (globs).
exclude = [
  "vendor/**",
  "**/*.pb.go",
  "**/*_generated.go",
  "**/*.gen.go",
  ".forge/cache/**",
  ".forge/llm-scratch/**",
]

[rules]
# Enable/disable individual rules from .forge/conventions.json.
# All rules are enabled by default; explicitly disable here.
# Example:
#   "test-parallel" = false   # disabled globally

[exceptions]
# Rule-specific path exceptions.
# Example:
#   "no-float-money" = ["internal/legacy/**"]  # legacy code; tracked in tech debt
