# Windsurf rules — {{.Name}}
# Generated by forge new ts-service (forge {{.ForgeVer}})

project: {{.Name}}
language: typescript

critical_rules:
  - "Never use number for monetary values — use bigint (cents) + Decimal"
  - "SQL queries must use $N parameterised placeholders only — no template literals in queries"
  - "Every DB query on a tenant-scoped table must include workspace_id filter"
  - "No hardcoded secrets; all credentials via process.env with fail-fast validation at startup"
  - "Throw typed Error subclasses (AppError, AuthError, etc.) — never raw strings"
  - "Catch blocks must log or rethrow — never silently discard errors"

structure:
  modules: "src/modules/<domain>/{service,controller,types,test}.ts"
  shared: "src/shared/{guards,decorators,middleware,types}/"
  infrastructure: "src/infrastructure/{database,queue,storage}/"
  migrations: "migrations/YYYYMMDDHHMMSS_description.sql"
  tests:
    unit: "tests/unit/"
    integration: "tests/integration/"
    security: "tests/security/   # required for every new RLS policy"

workflow:
  new_feature: "forge ship <feature>"
  new_migration: "forge generate migration <name>"
  new_handler: "forge generate handler <name>"
  scan: "forge scan security"
  check: "forge doctor && forge lint"
