# Forge-managed gitleaks rule pack (forge {{.ForgeVer}})
# Extended for TypeScript/Node.js projects.
title = "forge gitleaks ts-service"

[allowlist]
description = "Files we never scan"
paths = [
  '''(.*?)/?\.forge/cache/''',
  '''(.*?)/?node_modules/''',
  '''(.*?)/?dist/''',
  '''(.*?)/?build/''',
]

[[rules]]
id = "generic-api-key"
description = "Generic API key"
regex = '''(?i)(api[_-]?key|api_secret|secret|token|password)[\"\']?\s*[:=]\s*[\"\']?[A-Za-z0-9_\-]{20,}'''
tags = ["key", "generic"]

[[rules]]
id = "private-key-block"
description = "Private key PEM header"
regex = '''-----BEGIN ((EC|PGP|DSA|RSA|OPENSSH) )?PRIVATE KEY-----'''
tags = ["key", "private"]

[[rules]]
id = "openai-key"
description = "OpenAI API key"
regex = '''sk-[A-Za-z0-9]{20,}'''
tags = ["key", "openai"]

[[rules]]
id = "anthropic-key"
description = "Anthropic API key"
regex = '''sk-ant-[A-Za-z0-9\-_]{20,}'''
tags = ["key", "anthropic"]

[[rules]]
id = "aws-access-key"
description = "AWS access key ID"
regex = '''AKIA[0-9A-Z]{16}'''
tags = ["key", "aws"]

[[rules]]
id = "stripe-live-key"
description = "Stripe live key"
regex = '''(sk|pk|rk)_live_[A-Za-z0-9]{20,}'''
tags = ["key", "stripe", "payment"]

[[rules]]
id = "stripe-webhook-secret"
description = "Stripe webhook signing secret"
regex = '''whsec_[A-Za-z0-9]{20,}'''
tags = ["key", "stripe", "webhook"]

[[rules]]
id = "supabase-service-role"
description = "Supabase service-role JWT"
regex = '''eyJ[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+'''
tags = ["key", "supabase", "jwt"]

[[rules]]
id = "sendgrid-key"
description = "SendGrid API key"
regex = '''SG\.[A-Za-z0-9_\-]{22}\.[A-Za-z0-9_\-]{43}'''
tags = ["key", "sendgrid"]

[[rules]]
id = "high-entropy-env"
description = "High-entropy value assigned in .env files"
regex = '''(?i)[A-Z_]+(SECRET|KEY|TOKEN|PASSWORD|CREDENTIAL)\s*=\s*[A-Za-z0-9+/]{32,}'''
path = '''\.env'''
tags = ["key", "env"]
