import { describe, it, expect } from 'vitest';
import { createHmac } from 'node:crypto';
import { verifyToken } from '../../src/shared/middleware/auth.middleware.js';
import { UnauthorizedError, ForbiddenError } from '../../src/shared/errors.js';
import { createWorkspaceGuard } from '../../src/shared/guards/workspace.guard.js';
import type { WorkspaceContext } from '../../src/shared/types.js';

// ── Helpers ───────────────────────────────────────────────────────────────────

const TEST_SECRET = 'test-secret-for-tests-only';

function makeToken(
  payload: Record<string, unknown>,
  secret: string = TEST_SECRET,
): string {
  const header = Buffer.from(JSON.stringify({ alg: 'HS256', typ: 'JWT' })).toString('base64url');
  const body   = Buffer.from(JSON.stringify(payload)).toString('base64url');
  const sig    = createHmac('sha256', secret).update(`${header}.${body}`).digest('base64url');
  return `${header}.${body}.${sig}`;
}

function validPayload(overrides?: Record<string, unknown>): Record<string, unknown> {
  return {
    sub: 'user-1',
    wid: 'ws-abc',
    roles: ['member'],
    iat: Math.floor(Date.now() / 1000),
    exp: Math.floor(Date.now() / 1000) + 3600,
    ...overrides,
  };
}

// ── Token forgery ─────────────────────────────────────────────────────────────

describe('Token forgery', () => {
  it('rejects a token signed with the wrong secret', () => {
    const token = makeToken(validPayload(), 'wrong-secret');
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('rejects a token with a tampered payload', () => {
    const good = makeToken(validPayload());
    const parts = good.split('.');
    const tampered = Buffer.from(JSON.stringify({ ...validPayload(), roles: ['admin'] })).toString('base64url');
    const token = [parts[0], tampered, parts[2]].join('.');
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('rejects the none-algorithm trick (no signature)', () => {
    const header = Buffer.from(JSON.stringify({ alg: 'none', typ: 'JWT' })).toString('base64url');
    const body   = Buffer.from(JSON.stringify(validPayload())).toString('base64url');
    const token  = `${header}.${body}.`;
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('rejects a token with fewer than 3 parts', () => {
    expect(() => verifyToken('not.a.valid.jwt.token')).toThrow(UnauthorizedError);
    expect(() => verifyToken('onlyone')).toThrow(UnauthorizedError);
  });
});

// ── Expired tokens ────────────────────────────────────────────────────────────

describe('Token expiry', () => {
  it('rejects an expired token', () => {
    const token = makeToken(validPayload({ exp: Math.floor(Date.now() / 1000) - 1 }));
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('accepts a token that expires in the future', () => {
    const token = makeToken(validPayload());
    const claims = verifyToken(token);
    expect(claims.sub).toBe('user-1');
  });
});

// ── Missing claims ────────────────────────────────────────────────────────────

describe('Missing required claims', () => {
  it('rejects a token without sub', () => {
    const { sub: _sub, ...rest } = validPayload() as { sub: string; [k: string]: unknown };
    const token = makeToken(rest);
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('rejects a token without wid', () => {
    const { wid: _wid, ...rest } = validPayload() as { wid: string; [k: string]: unknown };
    const token = makeToken(rest);
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });

  it('rejects a token without exp', () => {
    const { exp: _exp, ...rest } = validPayload() as { exp: number; [k: string]: unknown };
    const token = makeToken(rest);
    expect(() => verifyToken(token)).toThrow(UnauthorizedError);
  });
});

// ── Timing attack guard ───────────────────────────────────────────────────────

describe('Timing-safe comparison', () => {
  it('takes approximately the same time for valid vs invalid signatures (no early exit)', () => {
    const good  = makeToken(validPayload());
    const parts = good.split('.');
    const bad   = [parts[0], parts[1], 'a'.repeat(parts[2].length)].join('.');

    const iterations = 100;

    let goodTotal = 0;
    for (let i = 0; i < iterations; i++) {
      const t0 = performance.now();
      try { verifyToken(good); } catch { /* ok */ }
      goodTotal += performance.now() - t0;
    }

    let badTotal = 0;
    for (let i = 0; i < iterations; i++) {
      const t0 = performance.now();
      try { verifyToken(bad); } catch { /* ok */ }
      badTotal += performance.now() - t0;
    }

    const ratio = Math.abs(goodTotal - badTotal) / Math.max(goodTotal, badTotal);
    // Allow up to 50% difference — anything larger would suggest early exit
    expect(ratio).toBeLessThan(0.5);
  });
});

// ── IDOR via workspace guard ──────────────────────────────────────────────────

describe('Workspace guard — IDOR prevention', () => {
  const ctx: WorkspaceContext = { workspaceId: 'ws-abc', userId: 'user-1', roles: ['member'] };

  it('allows access to own workspace', () => {
    const guard = createWorkspaceGuard(ctx);
    expect(() => guard.assertOwner('ws-abc')).not.toThrow();
  });

  it('blocks access to another workspace (IDOR)', () => {
    const guard = createWorkspaceGuard(ctx);
    expect(() => guard.assertOwner('ws-other')).toThrow(ForbiddenError);
  });

  it('throws UnauthorizedError when context is null (unauthenticated)', () => {
    expect(() => createWorkspaceGuard(null)).toThrow(UnauthorizedError);
  });

  it('throws UnauthorizedError when context is undefined', () => {
    expect(() => createWorkspaceGuard(undefined)).toThrow(UnauthorizedError);
  });

  it('enforces role checks', () => {
    const guard = createWorkspaceGuard(ctx);
    expect(() => guard.assertRole('admin')).toThrow(ForbiddenError);
    expect(() => guard.assertRole('member')).not.toThrow();
    expect(() => guard.assertRole('admin', 'member')).not.toThrow();
  });

  it('isOwner returns false for a different workspace (no throw)', () => {
    const guard = createWorkspaceGuard(ctx);
    expect(guard.isOwner('ws-other')).toBe(false);
    expect(guard.isOwner('ws-abc')).toBe(true);
  });
});
