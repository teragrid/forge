version: "3.9"

# docker-compose.yml — {{.Name}}
# Generated by forge new ts-service (forge {{.ForgeVer}})
# Local development environment: app + postgres + optional tooling.
#
# Usage:
#   docker-compose up -d          # start all services
#   docker-compose up -d postgres  # start only the database
#   docker-compose down           # stop and remove containers

services:
  # ── Application ───────────────────────────────────────────────────────────
  app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "3000:3000"
    environment:
      NODE_ENV: development
      DATABASE_URL: postgres://forge:forge@postgres:5432/{{.Name}}_dev
      LOG_LEVEL: debug
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - .:/app
      - /app/node_modules
    restart: unless-stopped

  # ── PostgreSQL ────────────────────────────────────────────────────────────
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: forge
      POSTGRES_PASSWORD: forge
      POSTGRES_DB: {{.Name}}_dev
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U forge -d {{.Name}}_dev"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # ── Test database (isolated from dev) ─────────────────────────────────────
  postgres_test:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: forge
      POSTGRES_PASSWORD: forge
      POSTGRES_DB: {{.Name}}_test
    ports:
      - "5433:5432"
    tmpfs:
      - /var/lib/postgresql/data  # in-memory: fast, disposable
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U forge -d {{.Name}}_test"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  postgres_data:
