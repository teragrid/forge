//
// Object storage stub. Defaults to local filesystem (for development) with an
// interface shaped for easy swap to S3 / R2 / GCS in production.
//
// Convention: never store raw PII in object storage without encryption at rest.
// The STORAGE_BUCKET_URL env var determines the backend:
//   - unset / "local" → filesystem at ./tmp/storage/<bucket>
//   - s3://bucket-name → AWS S3 (requires @aws-sdk/client-s3)
//   - r2://account.r2.cloudflarestorage.com → Cloudflare R2 (same SDK)

import { createReadStream, createWriteStream, mkdir, stat, unlink } from 'node:fs';
import { join, dirname } from 'node:path';
import { pipeline } from 'node:stream/promises';
import { Readable } from 'node:stream';
import { promisify } from 'node:util';
import { logger } from '../../shared/logger.js';

const mkdirAsync = promisify(mkdir);

// ── Storage interface ─────────────────────────────────────────────────────────
export interface StorageClient {
  put(bucket: string, key: string, body: Readable | Buffer, contentType?: string): Promise<void>;
  get(bucket: string, key: string): Promise<Readable>;
  delete(bucket: string, key: string): Promise<void>;
  exists(bucket: string, key: string): Promise<boolean>;
}

// ── Local filesystem storage (development / testing) ─────────────────────────
class LocalStorageClient implements StorageClient {
  private baseDir: string;

  constructor(baseDir = './tmp/storage') {
    this.baseDir = baseDir;
  }

  private resolve(bucket: string, key: string): string {
    // Prevent path traversal — key must not contain ../
    const safe = key.replace(/\.\./g, '_').replace(/^\//, '');
    return join(this.baseDir, bucket, safe);
  }

  async put(bucket: string, key: string, body: Readable | Buffer, _contentType?: string): Promise<void> {
    const dest = this.resolve(bucket, key);
    await mkdirAsync(dirname(dest), { recursive: true });
    const ws = createWriteStream(dest);
    if (Buffer.isBuffer(body)) {
      await pipeline(Readable.from(body), ws);
    } else {
      await pipeline(body, ws);
    }
    logger.debug({ bucket, key }, 'storage put');
  }

  async get(bucket: string, key: string): Promise<Readable> {
    const src = this.resolve(bucket, key);
    return createReadStream(src);
  }

  async delete(bucket: string, key: string): Promise<void> {
    const p = this.resolve(bucket, key);
    await unlink(p);
    logger.debug({ bucket, key }, 'storage delete');
  }

  async exists(bucket: string, key: string): Promise<boolean> {
    try {
      await new Promise<void>((resolve, reject) => stat(this.resolve(bucket, key), (e) => (e ? reject(e) : resolve())));
      return true;
    } catch {
      return false;
    }
  }
}

// ── Factory ───────────────────────────────────────────────────────────────────
export function createStorageClient(): StorageClient {
  const url = process.env.STORAGE_BUCKET_URL;
  if (!url || url === 'local') {
    logger.info('using local filesystem storage (./tmp/storage)');
    return new LocalStorageClient();
  }
  // TODO: add S3/R2/GCS adapters when STORAGE_BUCKET_URL is set
  // Example: if (url.startsWith('s3://')) return new S3StorageClient(url);
  logger.warn({ url }, 'STORAGE_BUCKET_URL set but no matching adapter — falling back to local');
  return new LocalStorageClient();
}

export const storage = createStorageClient();
