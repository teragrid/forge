// Job queue stub using pg-boss (Postgres-backed durable queue).
// Replace with BullMQ (Redis), SQS, or Cloud Tasks as your infra evolves.
//
// Why Postgres-backed? Zero extra infra — reuses the same DATABASE_URL.
// When you need Redis-scale throughput, swap the client here without changing callers.

import PgBoss from 'pg-boss';
import { logger } from '../../shared/logger.js';

let boss: PgBoss | null = null;

/**
 * Initialize and start the queue. Call once at server startup.
 * Idempotent — safe to call multiple times (returns existing instance).
 */
export async function getQueue(): Promise<PgBoss> {
  if (boss) return boss;
  const DATABASE_URL = process.env.DATABASE_URL;
  if (!DATABASE_URL) {
    throw new Error('DATABASE_URL is required to initialize the job queue');
  }
  boss = new PgBoss({ connectionString: DATABASE_URL });
  boss.on('error', (err) => logger.error({ err }, 'queue error'));
  await boss.start();
  logger.info('job queue started');
  return boss;
}

/**
 * Enqueue a job. The job will be picked up by a worker registered with
 * `subscribeQueue`. Jobs are durable: they survive server restarts.
 */
export async function enqueueJob<T extends object>(
  queue: string,
  data: T,
  options?: PgBoss.SendOptions,
): Promise<string | null> {
  const q = await getQueue();
  return q.send(queue, data, options);
}

/**
 * Register a worker for a queue. The worker function is called for each job.
 * Returns a subscription ID you can use to unsubscribe.
 */
export async function subscribeQueue<T extends object>(
  queue: string,
  worker: (job: PgBoss.Job<T>) => Promise<void>,
): Promise<string> {
  const q = await getQueue();
  const subscriptionId = await q.work<T>(queue, worker);
  logger.info({ queue }, 'queue worker registered');
  return subscriptionId;
}

/**
 * Gracefully stop the queue. Call during server shutdown.
 */
export async function closeQueue(): Promise<void> {
  if (boss) {
    await boss.stop();
    boss = null;
    logger.info('job queue stopped');
  }
}
