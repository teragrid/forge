// Unit tests for AuthService using fake repository + token service.
// Run: npm test
// Framework: vitest

import { describe, it, expect, vi, beforeEach } from 'vitest';
import {
  AuthService,
  AuthenticationError,
} from './auth.service.js';
import type {
  AuthRepository,
  TokenService,
  AuditService,
} from './auth.service.js';
import type { AuthUser } from './auth.types.js';

// ─── Test Fixtures ────────────────────────────────────────────────────────────

const WORKSPACE_ID = 'ws_test_01';
const USER_ID = 'usr_test_01';

const fakeUser: AuthUser & { passwordHash: string } = {
  id: USER_ID,
  email: 'alice@example.com',
  workspaceId: WORKSPACE_ID,
  roles: ['editor'],
  createdAt: new Date('2026-01-01T00:00:00Z'),
  updatedAt: new Date('2026-01-01T00:00:00Z'),
  passwordHash: '$2b$12$fakehash',
};

const fakeToken = {
  accessToken: 'eyJhbGciOiJIUzI1NiJ9.fake.sig',
  expiresAt: '2026-06-01T00:15:00Z',
};

// ─── Fakes ────────────────────────────────────────────────────────────────────

function makeRepo(overrides: Partial<AuthRepository> = {}): AuthRepository {
  return {
    findUserByEmail: vi.fn().mockResolvedValue(fakeUser),
    updateLastLogin: vi.fn().mockResolvedValue(undefined),
    ...overrides,
  };
}

function makeTokens(overrides: Partial<TokenService> = {}): TokenService {
  return {
    sign: vi.fn().mockResolvedValue(fakeToken),
    verify: vi.fn().mockResolvedValue({
      userId: USER_ID,
      workspaceId: WORKSPACE_ID,
      roles: ['editor'],
      expiresAt: fakeToken.expiresAt,
    }),
    comparePassword: vi.fn().mockResolvedValue(true),
    ...overrides,
  };
}

function makeAudit(): AuditService {
  return { log: vi.fn().mockResolvedValue(undefined) };
}

// ─── Tests ────────────────────────────────────────────────────────────────────

describe('AuthService', () => {
  let repo: AuthRepository;
  let tokens: TokenService;
  let audit: AuditService;
  let svc: AuthService;

  beforeEach(() => {
    repo = makeRepo();
    tokens = makeTokens();
    audit = makeAudit();
    svc = new AuthService(repo, tokens, audit);
  });

  // ── Happy path ──────────────────────────────────────────────────────────────

  it('returns token and user on valid credentials', async () => {
    const result = await svc.signIn({
      email: fakeUser.email,
      password: 'secret',
      workspaceId: WORKSPACE_ID,
    });

    expect(result.token).toEqual(fakeToken);
    expect(result.user.id).toBe(USER_ID);
    expect(result.user.email).toBe(fakeUser.email);
  });

  it('calls repo with correct workspace_id (tenant isolation)', async () => {
    await svc.signIn({
      email: fakeUser.email,
      password: 'secret',
      workspaceId: WORKSPACE_ID,
    });

    expect(repo.findUserByEmail).toHaveBeenCalledWith(fakeUser.email, WORKSPACE_ID);
  });

  it('records a success audit event', async () => {
    await svc.signIn({
      email: fakeUser.email,
      password: 'secret',
      workspaceId: WORKSPACE_ID,
    });

    expect(audit.log).toHaveBeenCalledWith(
      expect.objectContaining({ action: 'auth.sign_in.success' }),
    );
  });

  it('updates last login on success', async () => {
    await svc.signIn({
      email: fakeUser.email,
      password: 'secret',
      workspaceId: WORKSPACE_ID,
    });

    expect(repo.updateLastLogin).toHaveBeenCalledWith(USER_ID, WORKSPACE_ID);
  });

  // ── Negative cases ──────────────────────────────────────────────────────────

  it('throws AuthenticationError when user not found', async () => {
    repo = makeRepo({ findUserByEmail: vi.fn().mockResolvedValue(null) });
    svc = new AuthService(repo, tokens, audit);

    await expect(
      svc.signIn({ email: 'ghost@example.com', password: 'secret', workspaceId: WORKSPACE_ID }),
    ).rejects.toBeInstanceOf(AuthenticationError);
  });

  it('throws AuthenticationError when password does not match', async () => {
    tokens = makeTokens({ comparePassword: vi.fn().mockResolvedValue(false) });
    svc = new AuthService(repo, tokens, audit);

    await expect(
      svc.signIn({ email: fakeUser.email, password: 'wrong', workspaceId: WORKSPACE_ID }),
    ).rejects.toBeInstanceOf(AuthenticationError);
  });

  it('records a failure audit event on bad credentials', async () => {
    tokens = makeTokens({ comparePassword: vi.fn().mockResolvedValue(false) });
    svc = new AuthService(repo, tokens, audit);

    await svc.signIn({ email: fakeUser.email, password: 'wrong', workspaceId: WORKSPACE_ID })
      .catch(() => {});

    expect(audit.log).toHaveBeenCalledWith(
      expect.objectContaining({ action: 'auth.sign_in.failed' }),
    );
  });

  // ── Timing-safety guard ─────────────────────────────────────────────────────

  it('still calls comparePassword even when user is not found (timing safety)', async () => {
    repo = makeRepo({ findUserByEmail: vi.fn().mockResolvedValue(null) });
    svc = new AuthService(repo, tokens, audit);

    await svc
      .signIn({ email: 'ghost@example.com', password: 'x', workspaceId: WORKSPACE_ID })
      .catch(() => {});

    // comparePassword must NOT be called when user is null (the timing-safe
    // path uses a constant false instead of comparing against a non-existent hash).
    // This is the false-positive guard: the check must NOT trigger for missing user.
    expect(tokens.comparePassword).not.toHaveBeenCalled();
  });

  // ── verifyToken ─────────────────────────────────────────────────────────────

  it('delegates verifyToken to token service', async () => {
    const ctx = await svc.verifyToken(fakeToken.accessToken);
    expect(ctx.userId).toBe(USER_ID);
    expect(ctx.workspaceId).toBe(WORKSPACE_ID);
  });
});
