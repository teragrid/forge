type NodeHandler = (req: IncomingMessage, res: ServerResponse) => void;

// Reads the full request body and parses JSON.
async function readBody<T>(req: IncomingMessage): Promise<T> {
  return new Promise((resolve, reject) => {
    const chunks: Buffer[] = [];
    req.on('data', (chunk: Buffer) => chunks.push(chunk));
    req.on('end', () => {
      try {
        resolve(JSON.parse(Buffer.concat(chunks).toString() || 'null') as T);
      } catch {
        reject(new Error('Invalid JSON body'));
      }
    });
    req.on('error', reject);
  });
}

// Wraps the controller's framework-agnostic HttpRequest/HttpResponse adapters.
export function createAuthRouter(): NodeHandler {
  return async (req, res): Promise<void> => {
