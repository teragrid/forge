import type { AuthService } from './auth.service.js';
import type { SignInRequest, SignInResponse, RefreshRequest } from './auth.types.js';

/**
 * Minimal HTTP context type — replace with your actual framework's
 * Request/Response types (Express, Fastify, Hono, etc.).
 */
export interface HttpRequest<TBody = unknown> {
  body: TBody;
  headers: Record<string, string | undefined>;
  cookies: Record<string, string | undefined>;
}

export interface HttpResponse {
  json<T>(data: T, statusCode?: number): void;
  setCookie(name: string, value: string, options: CookieOptions): void;
  clearCookie(name: string): void;
}

export interface CookieOptions {
  httpOnly: boolean;
  secure: boolean;
  sameSite: 'strict' | 'lax' | 'none';
  maxAge: number;
  path: string;
}

const REFRESH_COOKIE = 'refresh_token';
const REFRESH_TTL_SECONDS = 7 * 24 * 60 * 60; // 7 days

export class AuthController {
  constructor(private readonly authService: AuthService) {}

  /**
   * POST /auth/sign-in
   * Body: { email, password, workspaceId }
   * Response: { token, user }  +  refresh_token cookie (HTTP-only)
   */
  async signIn(
    req: HttpRequest<SignInRequest>,
    res: HttpResponse,
  ): Promise<void> {
    const result: SignInResponse = await this.authService.signIn(req.body);

    // Refresh token travels only as an HTTP-only cookie — never in body.
    // The refresh token itself is generated and managed by the token service;
    // here we read it from a side-channel set during sign-in (adapter-specific).
    // Adjust the cookie value extraction to match your token service output.
    res.setCookie(REFRESH_COOKIE, 'REPLACE_WITH_REFRESH_TOKEN', {
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: REFRESH_TTL_SECONDS,
      path: '/auth',
    });

    res.json({ token: result.token, user: result.user }, 200);
  }

  /**
   * POST /auth/sign-out
   * Clears the refresh token cookie.
   */
  async signOut(
    _req: HttpRequest,
    res: HttpResponse,
  ): Promise<void> {
    res.clearCookie(REFRESH_COOKIE);
    res.json({ success: true }, 200);
  }

  /**
   * POST /auth/refresh
   * Body: { workspaceId }
   * Reads refresh_token from HTTP-only cookie.
   */
  async refresh(
    req: HttpRequest<RefreshRequest>,
    res: HttpResponse,
  ): Promise<void> {
    const refreshToken = req.cookies[REFRESH_COOKIE];
    if (!refreshToken) {
      res.json({ error: 'missing_refresh_token' }, 401);
      return;
    }
    // TODO: implement token rotation via TokenService.refresh()
    // For now, return 501 to indicate not yet implemented.
    res.json({ error: 'not_implemented' }, 501);
  }
}
