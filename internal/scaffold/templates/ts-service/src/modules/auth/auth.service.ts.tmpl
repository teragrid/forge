export class AuthService {
  constructor(
    private readonly repo: AuthRepository,
    private readonly tokens: TokenService,
    private readonly audit: AuditService,
  ) {}

  /**
   * Authenticates a user by email + password within a workspace.
   * Returns a short-lived access token on success.
   *
   * Forge conventions enforced here:
   * - workspace_id is always validated
   * - every outcome is audited
   * - passwords are compared with timing-safe comparison (via TokenService)
   */
  async signIn(req: SignInRequest): Promise<SignInResponse> {
    const user = await this.repo.findUserByEmail(req.email, req.workspaceId);

    // Timing-safe: always compare even when user is not found to prevent
    // user enumeration via response timing.
    const passwordMatch =
      user !== null
        ? await this.tokens.comparePassword(req.password, user.passwordHash)
        : false;

    if (!user || !passwordMatch) {
      await this.audit.log({
        action: 'auth.sign_in.failed',
        workspaceId: req.workspaceId,
        metadata: { email: req.email, reason: 'invalid_credentials' },
      });
      throw new AuthenticationError('invalid_credentials');
    }

    const token = await this.tokens.sign({
      userId: user.id,
      workspaceId: user.workspaceId,
      roles: user.roles,
    });

    await Promise.all([
      this.repo.updateLastLogin(user.id, user.workspaceId),
      this.audit.log({
        action: 'auth.sign_in.success',
        userId: user.id,
        workspaceId: user.workspaceId,
      }),
    ]);

    return {
      token,
      user: { id: user.id, email: user.email, roles: user.roles },
    };
  }

  /**
   * Verifies an access token and returns the decoded AuthContext.
   * Throws if the token is expired or tampered.
   */
  async verifyToken(token: string): Promise<AuthContext> {
    return this.tokens.verify(token);
  }
}

