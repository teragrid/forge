// ── Stub token service: symmetric HMAC-SHA256 JWT ────────────────────────────
import { createHmac, timingSafeEqual } from 'node:crypto';

const STUB_SECRET = process.env.JWT_SECRET ?? 'change-me-before-production';
const ACCESS_TTL_MS = 15 * 60 * 1000; // 15 minutes

function base64url(s: string): string {
  return Buffer.from(s).toString('base64url');
}

export const stubTokenService: TokenService = {
  async sign(payload) {
    const header = base64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
    const now = Date.now();
    const expiresAt = new Date(now + ACCESS_TTL_MS);
    const claims = base64url(JSON.stringify({ ...payload, exp: Math.floor(expiresAt.getTime() / 1000) }));
    const sig = createHmac('sha256', STUB_SECRET).update(`${header}.${claims}`).digest('base64url');
    return {
      accessToken: `${header}.${claims}.${sig}`,
      expiresAt,
      tokenType: 'Bearer',
    } satisfies AuthToken;
  },

  async verify(token) {
    const parts = token.split('.');
    if (parts.length !== 3) throw new Error('Invalid token format');
    const [header, claims, sig] = parts;
    const expected = createHmac('sha256', STUB_SECRET).update(`${header}.${claims}`).digest('base64url');
    const sigBuf = Buffer.from(sig, 'base64url');
    const expBuf = Buffer.from(expected, 'base64url');
    if (sigBuf.length !== expBuf.length || !timingSafeEqual(sigBuf, expBuf)) {
      throw new Error('Token signature invalid');
    }
    const decoded = JSON.parse(Buffer.from(claims, 'base64url').toString()) as AuthContext & { exp: number };
    if (Date.now() > decoded.exp * 1000) throw new Error('Token expired');
    return decoded;
  },

  async comparePassword(plain, hash) {
    // Dynamically import bcrypt so projects that don't install it still compile.
    // In production, add `bcrypt` (or `bcryptjs`) to dependencies.
    try {
      const { compare } = await import('bcryptjs');
      return compare(plain, hash);
    } catch {
      // Fallback: plain-text comparison for demo when bcryptjs is not installed.
      // NEVER USE THIS IN PRODUCTION.
      return plain === hash;
    }
  },
};

