import { createServer, type IncomingMessage, type ServerResponse } from 'node:http';
import { logger } from './shared/logger.js';
import { createAuthRouter } from './modules/auth/auth.routes.js';

const PORT = parseInt(process.env.PORT ?? '3000', 10);

// ── Assemble routers ──────────────────────────────────────────────────────────
const authRouter = createAuthRouter();

// ── HTTP handler ──────────────────────────────────────────────────────────────
function handler(req: IncomingMessage, res: ServerResponse): void {
  const url = req.url ?? '/';
  const method = req.method ?? 'GET';

  // Health checks — required by Forge conventions and the deploy workflows
  if (url === '/healthz' && method === 'GET') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ status: 'ok', service: '{{.Name}}' }));
    return;
  }
  if (url === '/readyz' && method === 'GET') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ status: 'ready', service: '{{.Name}}' }));
    return;
  }

  // Auth module routes: /auth/*
  if (url.startsWith('/auth')) {
    authRouter(req, res);
    return;
  }

  // 404 for everything else
  res.writeHead(404, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ error: 'Not found', path: url }));
}

// ── Server lifecycle ──────────────────────────────────────────────────────────
const server = createServer(handler);

server.listen(PORT, () => {
  logger.info({ port: PORT, service: '{{.Name}}', env: process.env.NODE_ENV }, 'server started');
});

// Graceful shutdown — honour SIGTERM from container orchestrators / forge deploy
function shutdown(signal: string): void {
  logger.info({ signal }, 'shutting down gracefully');
  server.close(() => {
    logger.info('server closed');
    process.exit(0);
  });
  // Force-kill after 10 s if outstanding requests don't drain
  setTimeout(() => {
    logger.warn('forced shutdown after timeout');
    process.exit(1);
  }, 10_000).unref();
}

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

export { server }; // exported for integration tests
