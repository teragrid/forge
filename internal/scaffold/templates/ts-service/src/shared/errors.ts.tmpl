//
// Typed error hierarchy. All domain errors extend AppError so:
//  - HTTP adapters can map .statusCode automatically
//  - Loggers can strip internal details before surfacing to clients
//  - Retry logic can inspect .retryable

export class AppError extends Error {
  /** HTTP status code to return to callers. */
  readonly statusCode: number;
  /** Machine-readable error code (e.g. "NOT_FOUND", "VALIDATION_FAILED"). */
  readonly code: string;
  /** Whether the operation can safely be retried. */
  readonly retryable: boolean;
  /** Structured metadata — never include PII. */
  readonly meta: Record<string, unknown>;

  constructor(
    message: string,
    options: {
      statusCode?: number;
      code?: string;
      retryable?: boolean;
      meta?: Record<string, unknown>;
      cause?: unknown;
    } = {},
  ) {
    super(message);
    this.name = this.constructor.name;
    this.statusCode = options.statusCode ?? 500;
    this.code = options.code ?? 'INTERNAL_ERROR';
    this.retryable = options.retryable ?? false;
    this.meta = options.meta ?? {};
    if (options.cause) {
      // Node 16.9+ Error.cause
      (this as NodeJS.ErrnoException).cause = options.cause as Error;
    }
    Error.captureStackTrace(this, this.constructor);
  }

  toJSON(): Record<string, unknown> {
    return {
      error: this.code,
      message: this.message,
      ...(Object.keys(this.meta).length ? { meta: this.meta } : {}),
    };
  }
}

// ── Domain errors ─────────────────────────────────────────────────────────────

export class NotFoundError extends AppError {
  constructor(resource: string, id?: string | number) {
    super(id ? `${resource} ${id} not found` : `${resource} not found`, {
      statusCode: 404,
      code: 'NOT_FOUND',
      retryable: false,
      meta: { resource, id },
    });
  }
}

export class ValidationError extends AppError {
  readonly fields?: Record<string, string>;

  constructor(message: string, fields?: Record<string, string>) {
    super(message, { statusCode: 400, code: 'VALIDATION_FAILED', retryable: false, meta: { fields } });
    this.fields = fields;
  }

  override toJSON(): Record<string, unknown> {
    return { ...super.toJSON(), ...(this.fields ? { fields: this.fields } : {}) };
  }
}

export class UnauthorizedError extends AppError {
  constructor(message = 'Authentication required') {
    super(message, { statusCode: 401, code: 'UNAUTHORIZED', retryable: false });
  }
}

export class ForbiddenError extends AppError {
  constructor(message = 'Insufficient permissions') {
    super(message, { statusCode: 403, code: 'FORBIDDEN', retryable: false });
  }
}

export class ConflictError extends AppError {
  constructor(message: string, meta?: Record<string, unknown>) {
    super(message, { statusCode: 409, code: 'CONFLICT', retryable: false, meta });
  }
}

export class RateLimitError extends AppError {
  readonly retryAfterSeconds?: number;

  constructor(retryAfterSeconds?: number) {
    super('Rate limit exceeded', {
      statusCode: 429,
      code: 'RATE_LIMITED',
      retryable: true,
      meta: retryAfterSeconds !== undefined ? { retryAfterSeconds } : {},
    });
    this.retryAfterSeconds = retryAfterSeconds;
  }
}

export class ExternalServiceError extends AppError {
  constructor(service: string, cause?: unknown) {
    super(`${service} is unavailable`, {
      statusCode: 502,
      code: 'EXTERNAL_SERVICE_ERROR',
      retryable: true,
      cause,
    });
  }
}

// ── Type guard ────────────────────────────────────────────────────────────────

export function isAppError(err: unknown): err is AppError {
  return err instanceof AppError;
}
