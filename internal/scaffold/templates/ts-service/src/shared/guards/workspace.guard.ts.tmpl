//
// Workspace ownership guard. Wraps service calls to assert that the acting
// user belongs to the target workspace before allowing the operation to proceed.
//
// Usage:
//   const guard = createWorkspaceGuard(ctx);
//   guard.assertOwner(resource.workspaceId); // throws ForbiddenError if mismatch

import { ForbiddenError, UnauthorizedError } from '../errors.js';
import { WorkspaceContext } from '../types.js';

// ── Guard ─────────────────────────────────────────────────────────────────────

export interface WorkspaceGuard {
  /**
   * Assert that the acting user's workspace matches the target workspace.
   * Throws ForbiddenError if they do not match.
   */
  assertOwner(targetWorkspaceId: string): void;

  /**
   * Assert that the acting user has at least one of the required roles.
   * Throws ForbiddenError if they do not.
   */
  assertRole(...requiredRoles: string[]): void;

  /**
   * Returns true if the acting user's workspace matches the target workspace.
   * Does NOT throw — use this for conditional logic.
   */
  isOwner(targetWorkspaceId: string): boolean;

  /**
   * Returns true if the acting user has at least one of the required roles.
   */
  hasRole(...roles: string[]): boolean;
}

/**
 * Create a workspace guard bound to a request context.
 * Throws UnauthorizedError if ctx is null/undefined (unauthenticated request).
 */
export function createWorkspaceGuard(ctx: WorkspaceContext | null | undefined): WorkspaceGuard {
  if (!ctx) {
    throw new UnauthorizedError('No workspace context — request is not authenticated');
  }

  return {
    assertOwner(targetWorkspaceId: string): void {
      if (ctx.workspaceId !== targetWorkspaceId) {
        throw new ForbiddenError(
          `Workspace ${targetWorkspaceId} is not accessible to workspace ${ctx.workspaceId}`,
        );
      }
    },

    assertRole(...requiredRoles: string[]): void {
      const hasAny = requiredRoles.some((r) => ctx.roles.includes(r));
      if (!hasAny) {
        throw new ForbiddenError(
          `Operation requires one of [${requiredRoles.join(', ')}]; user has [${ctx.roles.join(', ')}]`,
        );
      }
    },

    isOwner(targetWorkspaceId: string): boolean {
      return ctx.workspaceId === targetWorkspaceId;
    },

    hasRole(...roles: string[]): boolean {
      return roles.some((r) => ctx.roles.includes(r));
    },
  };
}
