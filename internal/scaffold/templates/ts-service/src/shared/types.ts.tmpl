// ── Pagination ────────────────────────────────────────────────────────────────

/** Opaque cursor (base64-encoded JSON internally). */
export type Cursor = string & { readonly _brand: 'Cursor' };

export interface PaginationInput {
  /** Max items to return. Capped at 100 server-side. */
  limit?: number;
  /** Cursor from the previous page's nextCursor field. */
  cursor?: Cursor;
}

export interface PaginatedResult<T> {
  items: T[];
  /** Present when there is a next page. Pass to the next request. */
  nextCursor?: Cursor;
  /** Total row count (only populated on first page to avoid expensive counts). */
  totalCount?: number;
}

// ── Result / Either ───────────────────────────────────────────────────────────

export type ServiceResult<T, E extends Error = Error> =
  | { ok: true; value: T }
  | { ok: false; error: E };

export function ok<T>(value: T): ServiceResult<T> {
  return { ok: true, value };
}

export function fail<E extends Error>(error: E): ServiceResult<never, E> {
  return { ok: false, error };
}

// ── Workspace / tenant context ────────────────────────────────────────────────

/**
 * Injected into every service call. All data access must be scoped to this
 * context to enforce workspace-level isolation (multi-tenancy).
 */
export interface WorkspaceContext {
  workspaceId: string;
  userId: string;
  /** Roles granted to the user in this workspace. */
  roles: string[];
}

