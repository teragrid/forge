//
// JWT verification middleware. Extracts the Bearer token from the Authorization
// header, verifies the signature, and attaches the decoded claims as
// `req.user` and `req.workspaceId` for downstream handlers.
//
// Security properties:
//  - Algorithm is pinned to HS256 (or RS256 if using asymmetric keys)
//  - Expired tokens are rejected (exp claim enforced by the JWT library)
//  - Missing workspaceId header is rejected to prevent cross-tenant access
//  - Timing-safe comparison used for workspace id verification

import { IncomingMessage, ServerResponse } from 'node:http';
import { createHmac, timingSafeEqual } from 'node:crypto';
import { UnauthorizedError, ForbiddenError } from '../errors.js';
import { logger } from '../logger.js';

// ── Types ─────────────────────────────────────────────────────────────────────

export interface JWTClaims {
  sub: string;          // userId
  wid: string;          // workspaceId
  roles: string[];
  iat: number;
  exp: number;
}

export interface AuthenticatedRequest extends IncomingMessage {
  user?: JWTClaims;
  workspaceId?: string;
}

// ── Token verification ────────────────────────────────────────────────────────

const JWT_SECRET = process.env.JWT_SECRET;
if (!JWT_SECRET && process.env.NODE_ENV !== 'test') {
  throw new Error('JWT_SECRET is not set. Export a 32-byte+ random value.');
}

/**
 * Verify an HMAC-SHA256 JWT. Returns the decoded payload or throws
 * UnauthorizedError. Constant-time signature comparison prevents timing attacks.
 */
export function verifyToken(token: string): JWTClaims {
  const parts = token.split('.');
  if (parts.length !== 3) throw new UnauthorizedError('Malformed token');

  const [headerB64, payloadB64, sigB64] = parts;

  // Verify signature
  const expected = createHmac('sha256', JWT_SECRET ?? 'test-secret-for-tests-only')
    .update(`${headerB64}.${payloadB64}`)
    .digest('base64url');

  const expectedBuf = Buffer.from(expected, 'utf8');
  const actualBuf   = Buffer.from(sigB64, 'utf8');

  if (
    expectedBuf.length !== actualBuf.length ||
    !timingSafeEqual(expectedBuf, actualBuf)
  ) {
    throw new UnauthorizedError('Invalid token signature');
  }

  let payload: JWTClaims;
  try {
    payload = JSON.parse(Buffer.from(payloadB64, 'base64url').toString('utf8')) as JWTClaims;
  } catch {
    throw new UnauthorizedError('Malformed token payload');
  }

  if (!payload.sub || !payload.wid || !payload.exp) {
    throw new UnauthorizedError('Token missing required claims');
  }
  if (Math.floor(Date.now() / 1000) > payload.exp) {
    throw new UnauthorizedError('Token expired');
  }

  return payload;
}

// ── Middleware ────────────────────────────────────────────────────────────────

type NextFn = (err?: unknown) => void;
type Middleware = (req: AuthenticatedRequest, res: ServerResponse, next: NextFn) => void;

/**
 * Express/Hono/Connect-compatible auth middleware.
 * Reads: Authorization: Bearer <jwt>
 * Reads: x-workspace-id header (must match the wid claim in the token)
 * Attaches: req.user (JWTClaims), req.workspaceId (string)
 */
export const authMiddleware: Middleware = (req, res, next) => {
  try {
    const authHeader = req.headers['authorization'];
    if (!authHeader?.startsWith('Bearer ')) {
      throw new UnauthorizedError('Authorization header missing or not Bearer');
    }
    const token = authHeader.slice(7);
    const claims = verifyToken(token);

    // Workspace ID header must match the token claim (defence-in-depth)
    const headerWid = req.headers['x-workspace-id'] as string | undefined;
    if (headerWid && headerWid !== claims.wid) {
      logger.warn({ headerWid, tokenWid: claims.wid }, 'workspace id mismatch');
      throw new ForbiddenError('Workspace ID mismatch');
    }

    req.user = claims;
    req.workspaceId = claims.wid;
    next();
  } catch (err) {
    next(err);
  }
};

/**
 * Optional auth middleware — attaches user if a valid token is present,
 * but does NOT reject requests without one (for public + authenticated routes).
 */
export const optionalAuthMiddleware: Middleware = (req, _res, next) => {
  const authHeader = req.headers['authorization'];
  if (authHeader?.startsWith('Bearer ')) {
    try {
      const claims = verifyToken(authHeader.slice(7));
      req.user = claims;
      req.workspaceId = claims.wid;
    } catch {
      // Ignore — optional auth
    }
  }
  next();
};
