# Windsurf rules — {{.Name}}
# Generated by forge new next-app (forge {{.ForgeVer}})

project: {{.Name}}
language: typescript
framework: nextjs

critical_rules:
  - "Server Components are the default — only add 'use client' for event handlers, browser APIs, or client hooks"
  - "NEXT_PUBLIC_ env vars are exposed to the browser — never use them for secrets"
  - "Security headers (X-Frame-Options, CSP, X-Content-Type-Options) must be present in next.config.ts"
  - "No hardcoded secrets; all credentials via process.env with fail-fast validation at startup"
  - "Throw typed Error subclasses — never raw strings"
  - "Catch blocks must log or rethrow — never silently discard errors"
  - "/api/health must always return {status:'ok'} at HTTP 200"

structure:
  pages: "app/<route>/page.tsx"
  layouts: "app/<route>/layout.tsx"
  api_routes: "app/api/<route>/route.ts"
  components: "components/<domain>/<Component>.tsx"
  utilities: "lib/<domain>/<util>.ts"
  tests:
    unit: "tests/unit/"
    e2e: "tests/e2e/   # Playwright end-to-end tests"

workflow:
  new_feature: "forge ship <feature>"
  scan: "forge scan security"
  check: "forge doctor && forge lint"

forge:
  version: "{{.ForgeVer}}"
