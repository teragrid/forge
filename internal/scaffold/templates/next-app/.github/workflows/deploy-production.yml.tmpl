name: Deploy — {{.Name}} (Production)
# forge-managed: v{{.ForgeVer}}

on:
  push:
    branches: [main]

jobs:
  deploy:
    name: Deploy to Production
    runs-on: ubuntu-latest
    environment: production
    concurrency:
      group: production
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      # Replace the step below with your platform's deploy command.
      # Example: Vercel
      # - name: Deploy to Vercel
      #   run: npx vercel --prod --token ${{ "{{" }} secrets.VERCEL_TOKEN {{ "}}" }}
      #
      # Example: Fly.io
      # - name: Deploy to Fly.io
      #   uses: superfly/flyctl-actions/setup-flyctl@master
      # - run: flyctl deploy --remote-only
      #   env:
      #     FLY_API_TOKEN: ${{ "{{" }} secrets.FLY_API_TOKEN {{ "}}" }}
      - name: Deploy (placeholder)
        run: echo "Configure your deployment platform in this step."

      - name: Health gate
        run: |
          sleep 10
          curl -sf "${{ "{{" }} secrets.PRODUCTION_URL {{ "}}" }}/api/health" | grep '"status":"ok"'
