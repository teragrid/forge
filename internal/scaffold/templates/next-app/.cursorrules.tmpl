# Cursor rules — {{.Name}}
# Generated by forge new next-app (forge {{.ForgeVer}})

project_name: {{.Name}}
language: typescript
framework: nextjs

rules:
  - id: server-components-default
    description: "Next.js App Router components are Server Components by default — only add 'use client' when required"
    severity: warning

  - id: no-client-env-secrets
    description: "NEXT_PUBLIC_ env vars are exposed to the browser — never use them for secrets"
    severity: error

  - id: no-any
    description: "Avoid TypeScript any — use unknown and narrow explicitly"
    pattern: ": any"
    severity: warning

  - id: no-silent-errors
    description: "Never discard errors — catch blocks must log or rethrow"
    pattern: "catch.*\\{\\s*\\}"
    severity: error

  - id: no-secrets-in-source
    description: "No hardcoded secrets, tokens, or credentials"
    severity: error

  - id: typed-error-classes
    description: "Throw typed Error subclasses, never raw strings"
    pattern: "throw ['\"]"
    severity: error

conventions:
  - "Pages live in app/<route>/page.tsx"
  - "Layouts live in app/<route>/layout.tsx"
  - "API routes live in app/api/<route>/route.ts"
  - "Shared components live in components/<domain>/"
  - "Pure utilities live in lib/<domain>/"
  - "Unit tests co-located or in tests/unit/"
  - "E2E tests in tests/e2e/ using Playwright"

forge:
  version: "{{.ForgeVer}}"
  ship_workflow: "forge ship <feature>"
  scan_family: "security"
