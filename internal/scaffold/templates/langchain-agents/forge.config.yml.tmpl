# forge.config.yml — {{.Name}}
# Generated by forge new langchain-agents (forge {{.ForgeVer}})
#
# Typed project configuration consumed by the Forge CLI.
# Run `forge doctor` to validate this file against the current schema.
# Full schema: https://forgeframework.dev/docs/config

version: "1"
project: "{{.Name}}"
description: "{{.Description}}"

# ── Runtime ────────────────────────────────────────────────────────────────
runtime: python
pythonVersion: ">=3.11"
entrypoint: "src/server.py"

# ── Multi-agent topology ────────────────────────────────────────────────────
agents:
  framework: langgraph          # langgraph | crewai | autogen
  orchestrator: supervisor      # supervisor | planner | react
  maxConcurrentAgents: 10
  maxIterations: 25             # per-graph-run circuit-breaker
  checkpointing: true           # persist graph state for resumability

# ── LLM providers ──────────────────────────────────────────────────────────
llm:
  # defaultProvider: openai | anthropic | azure-openai | local
  defaultProvider: openai
  # modelPolicy: which models agents may use (forge spend enforces this)
  modelPolicy:
    allow:
      - gpt-4o
      - gpt-4o-mini
      - claude-3-5-sonnet-20241022
      - claude-3-5-haiku-20241022
  # tokenBudget: max tokens per forge ship run (0 = unlimited)
  tokenBudget: 0
  # instructionsFormat: github-copilot | cursor | windsurf | all
  instructionsFormat: all
  # contextBundles: enable .forge/context/<task>.md auto-loading
  contextBundles: true
  # conventionLinter: error | warning | off
  conventionLinter: error
  # scratchRetention: how long to keep .forge/llm-scratch/ files
  scratchRetention: 7d

# ── Memory & retrieval ─────────────────────────────────────────────────────
memory:
  # vectorStore: pgvector | chroma | pinecone | weaviate
  vectorStore: pgvector
  embeddingModel: text-embedding-3-small
  # shortTerm: in-graph message window
  shortTermWindowSize: 20
  # longTerm: persisted to vector store
  longTermEnabled: true

# ── Tracing & observability ────────────────────────────────────────────────
observability:
  # langsmith: LangSmith project tracing (set LANGCHAIN_API_KEY in env)
  langsmith:
    enabled: true
    projectName: "{{.Name}}"
    traceAll: true
  # structuredLogging: JSON logs via structlog
  structuredLogging: true
  healthProbes:
    - /healthz
    - /readyz

# ── Tenancy ────────────────────────────────────────────────────────────────
tenancy:
  model: workspace
  isolationLevel: row
  tenantColumn: workspace_id

# ── Security ──────────────────────────────────────────────────────────────
security:
  owasp: strict
  rateLimit: true
  auditLog: true
  secretScan: true
  # promptInjectionScan: run forge scan prompt-injection in CI
  promptInjectionScan: true
  # outputGuardrails: validate agent outputs before returning to callers
  outputGuardrails: true

# ── Testing ────────────────────────────────────────────────────────────────
testing:
  coverage:
    statements: 80
    branches: 70
  promptInjectionTests: true
  agentDeterminismTests: true  # seed-based replay for reproducibility

# ── Deployment ────────────────────────────────────────────────────────────
deployment:
  pattern: rolling
  autoRollback: 5m
