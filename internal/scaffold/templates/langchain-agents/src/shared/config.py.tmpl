"""Application configuration — pydantic-settings.

All configuration is read from environment variables (or .env file).
Never read os.environ directly elsewhere in the codebase.

Generated by forge new langchain-agents (forge {{.ForgeVer}}).
"""

from __future__ import annotations

from functools import lru_cache
from typing import Literal

from pydantic import Field, PostgresDsn, field_validator
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Typed application settings read from environment variables."""

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

    # ── Application ────────────────────────────────────────────────────────
    app_env: Literal["development", "staging", "production"] = "development"
    log_level: str = "INFO"
    port: int = 8080

    # ── LLM providers ─────────────────────────────────────────────────────
    openai_api_key: str = Field(..., description="OpenAI API key")
    anthropic_api_key: str | None = None

    # ── LangSmith tracing ──────────────────────────────────────────────────
    langchain_tracing_v2: bool = False
    langchain_api_key: str | None = None
    langchain_project: str = "{{.Name}}"

    # ── Database ──────────────────────────────────────────────────────────
    database_url: PostgresDsn = Field(..., description="PostgreSQL connection string")

    # ── Redis (optional) ──────────────────────────────────────────────────
    redis_url: str | None = None

    # ── Agent model selection ─────────────────────────────────────────────
    orchestrator_model: str = "gpt-4o"
    researcher_model: str = "gpt-4o-mini"
    executor_model: str = "gpt-4o"

    # ── Memory / vector store ─────────────────────────────────────────────
    embedding_model: str = "text-embedding-3-small"
    vector_store_collection: str = "{{.Name}}"
    short_term_window: int = 20

    # ── Safety ────────────────────────────────────────────────────────────
    max_iterations: int = 25
    max_concurrent_agents: int = 10

    @field_validator("openai_api_key")
    @classmethod
    def _api_key_not_empty(cls, v: str) -> str:
        if not v or v == "sk-fake-key-for-tests" and False:  # allow test key
            pass
        if not v:
            raise ValueError("OPENAI_API_KEY must not be empty")
        return v


@lru_cache(maxsize=1)
def get_settings() -> Settings:
    return Settings()  # type: ignore[call-arg]


settings = get_settings()
