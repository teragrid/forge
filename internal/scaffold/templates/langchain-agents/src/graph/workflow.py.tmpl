"""LangGraph StateGraph workflow definition.

Nodes  : orchestrator → researcher | executor → orchestrator (loop) → END
Edges  : conditional routing via route_next(); human-in-the-loop interrupt
         before executor for irreversible actions.

Generated by forge new langchain-agents (forge {{.ForgeVer}}).
"""

from __future__ import annotations

from typing import Literal

import structlog
from langchain_core.runnables import RunnableConfig
from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver
from langgraph.graph import END, StateGraph

from src.agents.executor import ExecutorAgent
from src.agents.orchestrator import OrchestratorAgent
from src.agents.researcher import ResearcherAgent
from src.graph.state import AgentState
from src.shared.config import settings

log = structlog.get_logger(__name__)

# ── Routing ───────────────────────────────────────────────────────────────


def route_next(
    state: AgentState,
) -> Literal["researcher", "executor", "__end__"]:
    """Decide which node to visit after the orchestrator runs.

    Rules
    -----
    - If the plan is complete (current_step >= len(plan)) → END.
    - If the current step requires retrieval → researcher.
    - Otherwise → executor.
    """
    plan = state.get("plan", [])
    step = state.get("current_step", 0)

    if step >= len(plan):
        return END  # type: ignore[return-value]

    current_task = plan[step].lower()
    if any(kw in current_task for kw in ("research", "search", "find", "retrieve", "look up")):
        return "researcher"
    return "executor"


# ── Graph builder ─────────────────────────────────────────────────────────


def build_graph() -> StateGraph:
    """Build and compile the multi-agent StateGraph.

    The compiled graph is a LangChain Runnable and can be served directly
    via LangServe (``add_routes(app, build_graph(), path="/agents")``).
    """
    orchestrator = OrchestratorAgent()
    researcher = ResearcherAgent()
    executor = ExecutorAgent()

    workflow: StateGraph = StateGraph(AgentState)

    # ── Nodes ─────────────────────────────────────────────────────────────
    workflow.add_node("orchestrator", orchestrator.run)
    workflow.add_node("researcher", researcher.run)
    workflow.add_node("executor", executor.run)

    # ── Entry point ───────────────────────────────────────────────────────
    workflow.set_entry_point("orchestrator")

    # ── Edges ─────────────────────────────────────────────────────────────
    workflow.add_conditional_edges("orchestrator", route_next)

    # After researcher/executor, always return to orchestrator for next step
    workflow.add_edge("researcher", "orchestrator")
    workflow.add_edge("executor", "orchestrator")

    # ── Compile ───────────────────────────────────────────────────────────
    checkpointer = AsyncPostgresSaver.from_conn_string(settings.database_url)

    compiled = workflow.compile(
        checkpointer=checkpointer,
        # Pause before executor to allow human review of irreversible actions.
        # Remove this line to run fully autonomously.
        interrupt_before=["executor"],
    )

    log.info("graph compiled", nodes=list(workflow.nodes.keys()))
    return compiled
