# Cursor rules — cmdinit
# Generated by forge new ts-service (forge 9.9.9-test)

project_name: cmdinit
language: typescript

rules:
  - id: no-float-money
    description: "Never use number for monetary values — use bigint (cents) + Decimal"
    pattern: "float|number.*price|number.*amount|number.*balance"
    severity: error

  - id: sql-params-only
    description: "SQL queries must use $N placeholders, never template literals"
    pattern: "`.*SELECT|INSERT|UPDATE|DELETE.*\\$\\{"
    severity: error

  - id: workspace-id-filter
    description: "Every DB query on a tenant-scoped table must filter by workspace_id"
    severity: error

  - id: no-silent-errors
    description: "Never discard errors — catch blocks must log or rethrow"
    pattern: "catch.*\\{\\s*\\}"
    severity: error

  - id: no-secrets-in-source
    description: "No hardcoded secrets, tokens, or credentials"
    severity: error

  - id: structured-logging
    description: "Use pino for all production logging — no console.log in non-test code"
    pattern: "console\\.log|console\\.warn|console\\.error"
    severity: warning

  - id: typed-error-classes
    description: "Throw typed Error subclasses, never raw strings"
    pattern: "throw ['\"]"
    severity: error

conventions:
  - "Feature modules live in src/modules/<domain>/"
  - "Shared code lives in src/shared/{guards,decorators,middleware,types}/"
  - "Infrastructure adapters live in src/infrastructure/{database,queue,storage}/"
  - "Security tests for every new RLS policy in tests/security/"
  - "Co-locate unit tests as auth.test.ts next to auth.service.ts"
  - "SQL migration format: YYYYMMDDHHMMSS_description.sql"
  - "All DB queries must include workspace_id for tenant isolation"

forge:
  version: "9.9.9-test"
  ship_workflow: "forge ship <feature>"
  scan_family: "security"
