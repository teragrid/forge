{
  "name": "@forgeone/cli",
  "version": "1.0.0",
  "description": "Forge CLI — AI-native developer framework. Scaffold, lint, scan, ship.",
  "keywords": ["forge", "scaffold", "cli", "ai", "developer-tools", "devex"],
  "homepage": "https://forgeframework.dev",
  "bugs": {
    "url": "https://github.com/teragrid/forge/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teragrid/forge.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "bin": {
    "forge": "bin/forge.js"
  },
  "files": [
    "bin/forge.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@forgeone/cli-linux-x64": "1.0.0",
    "@forgeone/cli-linux-arm64": "1.0.0",
    "@forgeone/cli-darwin-x64": "1.0.0",
    "@forgeone/cli-darwin-arm64": "1.0.0",
    "@forgeone/cli-win32-x64": "1.0.0"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execFileSync(process.execPath,[require('path').join(__dirname,'bin','forge.js'),'--version'],{stdio:'pipe',timeout:5000})}catch(e){process.exit(0)}\""
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
